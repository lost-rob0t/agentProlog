# direnv configuration for agentProlog
#
# Secrets live in .env (git-ignored), never in this file.
# Run `direnv allow` once after checkout.

if [ -f .env ]; then
  dotenv .env
else
  echo "agentprolog: no .env found; copy .env.example to .env and set OPENROUTER_API_KEY for live model turns" >&2
fi

use flake
